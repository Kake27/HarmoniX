DATABASE_URL=postgresql+psycopg://user:password@host:5432/database
SUPABASE_URL=https://project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
FRONTEND_URL=http://localhost:5173

# All Cloudflare R2 settings are required. The bucket must already exist.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-private-bucket

# Redis URL for Celery background tasks
REDIS_URL=redis://localhost:6379/0

# Optional external ML inference services
DETECT_CHORDS_URL=http://localhost:8001
