# Supabase project settings (the public/publishable key is used by the browser).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
DATABASE_URL=postgresql+psycopg://postgres:your-url-encoded-password@db.your-project.supabase.co:5432/postgres?sslmode=require

# Public frontend build settings. API requests go through the frontend container's
# Nginx reverse proxy, so keep this as /api/v1 for the standard Compose setup.
VITE_API_BASE_URL=/api/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# The app is served at localhost:5173. For non-local access, set the exact public
# frontend origin and configure Supabase redirect URLs and R2 bucket CORS too.
FRONTEND_URL=http://localhost:5173

# Cloudflare R2 is required for audio storage and signed playback/download URLs.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-private-bucket

# Redis URL: use redis://redis:6379/0 when running in Docker Compose,
# or redis://localhost:6379/0 when running the backend locally outside Docker.
REDIS_URL=redis://redis:6379/0

# Optional external ML inference services
DETECT_CHORDS_URL=http://chord_service:8001
